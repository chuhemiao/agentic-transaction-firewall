{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atf.dev/schemas/transaction-intent.schema.json",
  "title": "ATF Transaction Intent",
  "description": "Canonical Transaction Intent (PRD docs/PRD.md §9).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "intent_id",
    "idempotency_key",
    "created_at",
    "expires_at",
    "principal",
    "mandate",
    "action",
    "resource",
    "transaction"
  ],
  "properties": {
    "spec_version": { "type": "string", "enum": ["1.0"] },
    "intent_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "agent_id"],
      "properties": {
        "organization_id": { "type": "string", "minLength": 1 },
        "user_id": { "type": ["string", "null"] },
        "agent_id": { "type": "string", "minLength": 1 },
        "agent_version": { "type": ["string", "null"] },
        "strategy_id": { "type": ["string", "null"] }
      }
    },
    "mandate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mandate_id", "purpose", "human_authorized"],
      "properties": {
        "mandate_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": ["string", "null"] },
        "purpose": { "type": "string", "minLength": 1 },
        "budget_id": { "type": ["string", "null"] },
        "human_authorized": { "type": "boolean" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "operation"],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "payment",
            "transfer",
            "token_approval",
            "contract_call",
            "exchange_order",
            "treasury_rebalance",
            "swap",
            "borrow",
            "lend",
            "stake",
            "bridge",
            "prediction_market_order",
            "subscription",
            "recurring_payment",
            "refund",
            "withdrawal"
          ]
        },
        "operation": { "type": "string", "minLength": 1 }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "resource_id"],
      "properties": {
        "protocol": { "type": "string", "minLength": 1 },
        "venue": { "type": ["string", "null"] },
        "resource_id": { "type": "string", "minLength": 1 },
        "resource_type": { "type": ["string", "null"] }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "asset", "amount"],
      "properties": {
        "network": { "type": "string", "minLength": 1 },
        "asset": { "type": "string", "minLength": 1 },
        "amount": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
        "destination": { "type": ["string", "null"] },
        "contract": { "type": ["string", "null"] },
        "calldata_hash": { "type": ["string", "null"] },
        "max_fee": { "type": ["string", "null"], "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
        "slippage_bps": { "type": ["integer", "null"] },
        "leverage": { "type": ["string", "null"], "pattern": "^-?[0-9]+(\\.[0-9]+)?$" }
      }
    },
    "context": { "type": "object" },
    "metadata": { "type": "object" }
  }
}
