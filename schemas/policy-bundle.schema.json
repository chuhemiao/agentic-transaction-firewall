{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atf.dev/schemas/policy-bundle.schema.json",
  "title": "ATF Policy Bundle Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "bundle_id",
    "policy_version",
    "scope",
    "activates_at",
    "expires_at",
    "cedar_schema",
    "policy_files",
    "bundle_hash"
  ],
  "properties": {
    "manifest_version": { "const": "1" },
    "bundle_id": { "$ref": "#/$defs/identifier" },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "environment"],
      "properties": {
        "organization_id": { "$ref": "#/$defs/identifier" },
        "environment": { "$ref": "#/$defs/identifier" }
      }
    },
    "activates_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "cedar_schema": { "$ref": "#/$defs/file" },
    "policy_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/file" }
    },
    "bundle_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
