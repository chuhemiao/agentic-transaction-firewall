{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atf.dev/schemas/audit-event.schema.json",
  "title": "ATF Audit Event",
  "description": "One versioned, typed entry in the append-only Audit Ledger hash chain (docs/PRD.md §16 and docs/audit-model.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "intent_id",
    "prev_event_hash",
    "data"
  ],
  "properties": {
    "event_id": { "$ref": "#/$defs/nonEmpty" },
    "event_type": {
      "type": "string",
      "enum": [
        "IntentReceived",
        "IdentityVerified",
        "IdentityVerificationSkipped",
        "IdentityRejected",
        "ReplayDetected",
        "ContextEnriched",
        "PolicyEvaluated",
        "RiskEvaluated",
        "DecisionRecorded",
        "SimulationCompleted",
        "ApprovalRequested",
        "ApprovalApproved",
        "ApprovalGranted",
        "ApprovalRejected",
        "ExecutionGrantIssued",
        "ExecutionRequested",
        "ExecutionSubmitted",
        "ExecutionConfirmed",
        "ExecutionFailed",
        "SettlementVerified",
        "ServiceDelivered",
        "ReconciliationFailed",
        "BudgetReserved",
        "BudgetCommitted",
        "BudgetReleased",
        "KillSwitchTriggered",
        "KillSwitchEnabled",
        "KillSwitchDisabled",
        "PolicyChanged",
        "AgentPaused",
        "AgentRegistered",
        "AgentStatusChanged",
        "IdentityKeyRegistered",
        "IdentityKeyRevoked",
        "OperatorRegistered",
        "OperatorStatusChanged",
        "OperatorRoleGranted",
        "OperatorRoleRevoked",
        "RiskRuleSetStored",
        "OriginalReplayCompleted",
        "CounterfactualReplayCompleted",
        "IntentExpired",
        "IntentCancelled"
      ]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "intent_id": { "type": ["string", "null"] },
    "prev_event_hash": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "data": { "type": "object" }
  },
  "oneOf": [
    { "$ref": "#/$defs/intentReceivedEvent" },
    { "$ref": "#/$defs/identityVerifiedEvent" },
    { "$ref": "#/$defs/identityVerificationSkippedEvent" },
    { "$ref": "#/$defs/identityRejectedEvent" },
    { "$ref": "#/$defs/replayDetectedEvent" },
    { "$ref": "#/$defs/contextEnrichedEvent" },
    { "$ref": "#/$defs/policyEvaluatedEvent" },
    { "$ref": "#/$defs/riskEvaluatedEvent" },
    { "$ref": "#/$defs/simulationCompletedEvent" },
    { "$ref": "#/$defs/decisionRecordedEvent" },
    { "$ref": "#/$defs/approvalRequestedEvent" },
    { "$ref": "#/$defs/approvalApprovedEvent" },
    { "$ref": "#/$defs/approvalRejectedEvent" },
    { "$ref": "#/$defs/executionGrantIssuedEvent" },
    { "$ref": "#/$defs/executionSubmittedEvent" },
    { "$ref": "#/$defs/executionConfirmedEvent" },
    { "$ref": "#/$defs/executionFailedEvent" },
    { "$ref": "#/$defs/settlementVerifiedEvent" },
    { "$ref": "#/$defs/serviceDeliveredEvent" },
    { "$ref": "#/$defs/reconciliationFailedEvent" },
    { "$ref": "#/$defs/budgetReservedEvent" },
    { "$ref": "#/$defs/budgetCommittedEvent" },
    { "$ref": "#/$defs/budgetReleasedEvent" },
    { "$ref": "#/$defs/policyChangedEvent" },
    { "$ref": "#/$defs/agentPausedEvent" },
    { "$ref": "#/$defs/agentRegisteredEvent" },
    { "$ref": "#/$defs/agentStatusChangedEvent" },
    { "$ref": "#/$defs/identityKeyRegisteredEvent" },
    { "$ref": "#/$defs/identityKeyRevokedEvent" },
    { "$ref": "#/$defs/operatorRegisteredEvent" },
    { "$ref": "#/$defs/operatorStatusChangedEvent" },
    { "$ref": "#/$defs/operatorRoleGrantedEvent" },
    { "$ref": "#/$defs/operatorRoleRevokedEvent" },
    { "$ref": "#/$defs/riskRuleSetStoredEvent" },
    { "$ref": "#/$defs/originalReplayCompletedEvent" },
    { "$ref": "#/$defs/counterfactualReplayCompletedEvent" },
    { "$ref": "#/$defs/killSwitchEnabledEvent" },
    { "$ref": "#/$defs/killSwitchDisabledEvent" },
    { "$ref": "#/$defs/intentExpiredEvent" },
    { "$ref": "#/$defs/intentCancelledEvent" },
    { "$ref": "#/$defs/legacyEvent" }
  ],
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"
    },
    "nonEmptyList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "amount": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "versionedArtifactReference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "artifact_id", "version", "hash"],
          "properties": {
            "status": { "const": "AVAILABLE" },
            "artifact_id": { "$ref": "#/$defs/nonEmpty" },
            "version": { "$ref": "#/$defs/nonEmpty" },
            "hash": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason_code"],
          "properties": {
            "status": { "const": "UNAVAILABLE" },
            "reason_code": { "$ref": "#/$defs/nonEmpty" }
          }
        }
      ]
    },
    "decisionSimulationReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code"],
      "properties": {
        "status": { "const": "NOT_RUN" },
        "reason_code": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "decisionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "version": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "decisionRequiredApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "count"],
      "properties": {
        "role": { "$ref": "#/$defs/nonEmpty" },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "decisionObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "decisionExecutionConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_category", "action_operation", "resource_id", "resource_protocol", "network", "asset", "max_amount", "destination", "adapter_id"],
      "properties": {
        "action_category": { "$ref": "#/$defs/nonEmpty" },
        "action_operation": { "$ref": "#/$defs/nonEmpty" },
        "resource_id": { "$ref": "#/$defs/nonEmpty" },
        "resource_protocol": { "$ref": "#/$defs/nonEmpty" },
        "network": { "$ref": "#/$defs/nonEmpty" },
        "asset": { "$ref": "#/$defs/nonEmpty" },
        "max_amount": { "$ref": "#/$defs/amount" },
        "destination": {
          "oneOf": [
            { "$ref": "#/$defs/nonEmpty" },
            { "type": "null" }
          ]
        },
        "adapter_id": {
          "oneOf": [
            { "$ref": "#/$defs/nonEmpty" },
            { "type": "null" }
          ]
        }
      }
    },
    "decisionBindingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_version", "profile", "policy", "risk", "evaluation_context_hash", "context_snapshot_hash", "simulation", "evaluation_time", "expires_at", "required_approvals", "obligations", "execution_constraints"],
      "properties": {
        "decision_version": { "const": "1" },
        "profile": { "$ref": "#/$defs/decisionProfile" },
        "policy": { "$ref": "#/$defs/versionedArtifactReference" },
        "risk": { "$ref": "#/$defs/versionedArtifactReference" },
        "evaluation_context_hash": { "$ref": "#/$defs/sha256" },
        "context_snapshot_hash": { "$ref": "#/$defs/sha256" },
        "simulation": { "$ref": "#/$defs/decisionSimulationReference" },
        "evaluation_time": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "required_approvals": {
          "type": "array",
          "items": { "$ref": "#/$defs/decisionRequiredApproval" }
        },
        "obligations": {
          "type": "array",
          "items": { "$ref": "#/$defs/decisionObligation" }
        },
        "execution_constraints": { "$ref": "#/$defs/decisionExecutionConstraints" }
      }
    },
    "intentScope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "operatorScope": { "type": "null" },
    "agentStatus": {
      "enum": ["ACTIVE", "SHADOW_ONLY", "PAUSED", "REVOKED", "EXPIRED"]
    },
    "operatorKind": { "enum": ["HUMAN", "SERVICE"] },
    "operatorStatus": { "enum": ["ACTIVE", "DISABLED"] },
    "operatorRole": { "enum": ["org_admin", "policy_author", "approver", "auditor"] },
    "roleBindingStatus": { "enum": ["ACTIVE", "REVOKED"] },
    "policyOutcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "result"],
          "properties": {
            "status": { "const": "SUCCEEDED" },
            "result": { "enum": ["PERMIT", "FORBID"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "error_code"],
          "properties": {
            "status": { "const": "ERROR" },
            "error_code": { "$ref": "#/$defs/nonEmpty" }
          }
        }
      ]
    },
    "riskFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity"],
      "properties": {
        "code": { "$ref": "#/$defs/nonEmpty" },
        "severity": { "enum": ["INFO", "MEDIUM", "HIGH", "CRITICAL"] }
      }
    },
    "riskOutcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "result"],
          "properties": {
            "status": { "const": "SUCCEEDED" },
            "result": {
              "type": "array",
              "items": { "$ref": "#/$defs/riskFinding" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "error_code"],
          "properties": {
            "status": { "const": "ERROR" },
            "error_code": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason_code"],
          "properties": {
            "status": { "const": "NOT_RUN" },
            "reason_code": { "$ref": "#/$defs/nonEmpty" }
          }
        }
      ]
    },
    "simulationOutcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "result"],
          "properties": {
            "status": { "const": "SUCCEEDED" },
            "result": { "enum": ["SAFE", "REVIEW", "UNSAFE"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "error_code"],
          "properties": {
            "status": { "const": "ERROR" },
            "error_code": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason_code"],
          "properties": {
            "status": { "const": "NOT_RUN" },
            "reason_code": { "$ref": "#/$defs/nonEmpty" }
          }
        }
      ]
    },
    "intentReceived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "organization_id", "agent_id", "idempotency_key", "intent_hash", "amount", "resource_id"],
      "properties": {
        "schema_version": { "const": 1 },
        "organization_id": { "$ref": "#/$defs/nonEmpty" },
        "agent_id": { "$ref": "#/$defs/nonEmpty" },
        "idempotency_key": { "$ref": "#/$defs/nonEmpty" },
        "intent_hash": { "$ref": "#/$defs/sha256" },
        "amount": { "$ref": "#/$defs/amount" },
        "resource_id": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "identityVerified": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "organization_id", "agent_id", "key_id", "envelope_hash"],
      "properties": {
        "schema_version": { "const": 1 },
        "organization_id": { "$ref": "#/$defs/nonEmpty" },
        "agent_id": { "$ref": "#/$defs/nonEmpty" },
        "key_id": { "$ref": "#/$defs/nonEmpty" },
        "envelope_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "identityVerificationSkipped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "organization_id", "agent_id", "reason_code"],
      "properties": {
        "schema_version": { "const": 1 },
        "organization_id": { "$ref": "#/$defs/nonEmpty" },
        "agent_id": { "$ref": "#/$defs/nonEmpty" },
        "reason_code": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "identityRejected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "organization_id", "agent_id", "reason_code"],
      "properties": {
        "schema_version": { "const": 1 },
        "organization_id": { "$ref": "#/$defs/nonEmpty" },
        "agent_id": { "$ref": "#/$defs/nonEmpty" },
        "reason_code": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "replayDetected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "organization_id",
        "agent_id",
        "key_id",
        "nonce_hash",
        "attempted_intent_id",
        "attempted_intent_hash",
        "bound_intent_id",
        "bound_intent_hash",
        "reason_code"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "organization_id": { "$ref": "#/$defs/nonEmpty" },
        "agent_id": { "$ref": "#/$defs/nonEmpty" },
        "key_id": { "$ref": "#/$defs/nonEmpty" },
        "nonce_hash": { "$ref": "#/$defs/sha256" },
        "attempted_intent_id": { "$ref": "#/$defs/nonEmpty" },
        "attempted_intent_hash": { "$ref": "#/$defs/sha256" },
        "bound_intent_id": { "$ref": "#/$defs/nonEmpty" },
        "bound_intent_hash": { "$ref": "#/$defs/sha256" },
        "reason_code": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "contextEnriched": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "context_hash", "source_ids"],
      "properties": {
        "schema_version": { "const": 1 },
        "context_hash": { "$ref": "#/$defs/sha256" },
        "source_ids": { "$ref": "#/$defs/nonEmptyList" }
      }
    },
    "policyEvaluated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "outcome", "policy_ids"],
      "properties": {
        "schema_version": { "const": 1 },
        "outcome": { "$ref": "#/$defs/policyOutcome" },
        "policy_ids": { "$ref": "#/$defs/stringList" }
      }
    },
    "riskEvaluated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "outcome"],
      "properties": {
        "schema_version": { "const": 1 },
        "risk_rule_set_version": { "$ref": "#/$defs/nonEmpty" },
        "risk_rule_set_hash": { "$ref": "#/$defs/sha256" },
        "history": { "$ref": "#/$defs/riskHistorySnapshot" },
        "outcome": { "$ref": "#/$defs/riskOutcome" }
      },
      "allOf": [
        {
          "if": { "required": ["risk_rule_set_version"] },
          "then": { "required": ["risk_rule_set_hash"] }
        },
        {
          "if": { "required": ["risk_rule_set_hash"] },
          "then": { "required": ["risk_rule_set_version"] }
        }
      ]
    },
    "riskHistorySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "$ref": "#/$defs/repositorySnapshot" },
        "duplicate_purchase": { "$ref": "#/$defs/duplicatePurchaseHistory" },
        "daily_cumulative_spend": { "$ref": "#/$defs/dailySpendHistory" }
      }
    },
    "repositorySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "through_sequence", "snapshot_hash"],
      "properties": {
        "snapshot_id": { "$ref": "#/$defs/nonEmpty" },
        "through_sequence": { "type": "integer", "minimum": 1 },
        "snapshot_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "duplicatePurchaseHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "result"],
      "properties": {
        "query": { "$ref": "#/$defs/duplicatePurchaseQuery" },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/duplicatePurchaseMatch" },
            { "type": "null" }
          ]
        }
      }
    },
    "duplicatePurchaseQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "agent_id", "resource_id", "current_intent_id", "evaluation_time", "window_start", "window_seconds", "accounting_boundary"],
      "properties": {
        "organization_id": { "$ref": "#/$defs/nonEmpty" },
        "agent_id": { "$ref": "#/$defs/nonEmpty" },
        "resource_id": { "$ref": "#/$defs/nonEmpty" },
        "current_intent_id": { "$ref": "#/$defs/nonEmpty" },
        "evaluation_time": { "type": "string", "format": "date-time" },
        "window_start": { "type": "string", "format": "date-time" },
        "window_seconds": { "type": "integer", "minimum": 1, "maximum": 2678400 },
        "accounting_boundary": { "enum": ["REQUESTED", "PERMITTED", "EXECUTED", "SETTLED"] }
      }
    },
    "duplicatePurchaseMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_id", "decision_id", "boundary_event_id", "boundary_sequence", "occurred_at"],
      "properties": {
        "intent_id": { "$ref": "#/$defs/nonEmpty" },
        "decision_id": { "$ref": "#/$defs/nonEmpty" },
        "boundary_event_id": { "$ref": "#/$defs/nonEmpty" },
        "boundary_sequence": { "type": "integer", "minimum": 1 },
        "occurred_at": { "type": "string", "format": "date-time" }
      }
    },
    "dailySpendHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "totals", "unresolved_asset_decision_count"],
      "properties": {
        "query": { "$ref": "#/$defs/dailySpendQuery" },
        "totals": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/dailySpendAssetTotal" }
        },
        "unresolved_asset_decision_count": { "type": "integer", "minimum": 0 }
      }
    },
    "dailySpendQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "agent_id", "current_intent_id", "valuation_asset", "evaluation_time", "window_start", "window_seconds", "accounting_boundary"],
      "properties": {
        "organization_id": { "$ref": "#/$defs/nonEmpty" },
        "agent_id": { "$ref": "#/$defs/nonEmpty" },
        "current_intent_id": { "$ref": "#/$defs/nonEmpty" },
        "valuation_asset": { "type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[A-Za-z0-9._:%/-]+$" },
        "evaluation_time": { "type": "string", "format": "date-time" },
        "window_start": { "type": "string", "format": "date-time" },
        "window_seconds": { "type": "integer", "minimum": 1, "maximum": 2678400 },
        "accounting_boundary": { "enum": ["REQUESTED", "PERMITTED", "EXECUTED", "SETTLED"] }
      }
    },
    "dailySpendAssetTotal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "amount", "decision_count"],
      "properties": {
        "asset": { "type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[A-Za-z0-9._:%/-]+$" },
        "amount": { "$ref": "#/$defs/amount" },
        "decision_count": { "type": "integer", "minimum": 1 }
      }
    },
    "simulationCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "outcome"],
      "properties": {
        "schema_version": { "const": 1 },
        "outcome": { "$ref": "#/$defs/simulationOutcome" }
      }
    },
    "decisionRecorded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "organization_id", "agent_id", "intent_hash", "evaluation_id", "evaluation_hash", "decision_id", "decision_hash", "decision", "action_category", "resource_id", "amount", "destination"],
      "properties": {
        "schema_version": { "const": 1 },
        "organization_id": { "$ref": "#/$defs/nonEmpty" },
        "agent_id": { "$ref": "#/$defs/nonEmpty" },
        "intent_hash": { "$ref": "#/$defs/sha256" },
        "evaluation_id": { "$ref": "#/$defs/nonEmpty" },
        "evaluation_hash": { "$ref": "#/$defs/sha256" },
        "decision_id": { "$ref": "#/$defs/nonEmpty" },
        "decision_hash": { "$ref": "#/$defs/sha256" },
        "decision": { "enum": ["PERMIT", "DENY", "REVIEW", "ERROR"] },
        "action_category": { "$ref": "#/$defs/nonEmpty" },
        "resource_id": { "$ref": "#/$defs/nonEmpty" },
        "amount": { "$ref": "#/$defs/amount" },
        "destination": {
          "oneOf": [
            { "$ref": "#/$defs/nonEmpty" },
            { "type": "null" }
          ]
        },
        "binding": { "$ref": "#/$defs/decisionBindingEvidence" }
      }
    },
    "approvalRequested": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "approval_id", "decision_id", "required_roles"],
      "properties": {
        "schema_version": { "const": 1 },
        "approval_id": { "$ref": "#/$defs/nonEmpty" },
        "decision_id": { "$ref": "#/$defs/nonEmpty" },
        "required_roles": { "$ref": "#/$defs/nonEmptyList" }
      }
    },
    "approvalApproved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "approval_id", "approver_id"],
      "properties": {
        "schema_version": { "const": 1 },
        "approval_id": { "$ref": "#/$defs/nonEmpty" },
        "approver_id": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "approvalRejected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "approval_id", "approver_id", "reason_code"],
      "properties": {
        "schema_version": { "const": 1 },
        "approval_id": { "$ref": "#/$defs/nonEmpty" },
        "approver_id": { "$ref": "#/$defs/nonEmpty" },
        "reason_code": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "executionGrantIssued": {
      "type": "object",
