{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atf.dev/schemas/policy-bundle-signature.schema.json",
  "title": "ATF Policy Bundle Detached Signature v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signature_version",
    "algorithm",
    "key_id",
    "bundle_hash",
    "signature"
  ],
  "properties": {
    "signature_version": { "const": "1" },
    "algorithm": { "const": "Ed25519" },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "bundle_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  }
}
