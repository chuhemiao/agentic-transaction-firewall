{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atf.dev/schemas/risk-rule-set.schema.json",
  "title": "ATF Risk Rule Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule_set_format_version", "rule_set_version", "engine_version", "rules"],
  "properties": {
    "rule_set_format_version": { "const": "1" },
    "rule_set_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "engine_version": { "const": "atf-risk-engine-v1" },
    "rules": { "$ref": "#/$defs/rules" }
  },
  "$defs": {
    "severity": { "enum": ["info", "medium", "high", "critical"] },
    "missingData": { "enum": ["NOT_APPLICABLE", "FINDING"] },
    "accountingBoundary": { "enum": ["REQUESTED", "PERMITTED", "EXECUTED", "SETTLED"] },
    "toggleRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "severity"],
      "properties": {
        "enabled": { "type": "boolean" },
        "severity": { "$ref": "#/$defs/severity" }
      }
    },
    "amountCapRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "severity", "max_amount"],
      "properties": {
        "enabled": { "type": "boolean" },
        "severity": { "$ref": "#/$defs/severity" },
        "max_amount": {
          "oneOf": [
            { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": { "properties": { "max_amount": { "type": "string" } } }
        }
      ]
    },
    "basisPointRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "severity", "threshold_bps", "missing_data"],
      "properties": {
        "enabled": { "type": "boolean" },
        "severity": { "$ref": "#/$defs/severity" },
        "threshold_bps": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "missing_data": { "$ref": "#/$defs/missingData" }
      }
    },
    "vendorPriceRule": {
      "allOf": [
        { "$ref": "#/$defs/basisPointRule" },
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "properties": { "missing_data": { "const": "FINDING" } }
          }
        }
      ]
    },
    "denyListRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "severity", "networks", "protocols"],
      "properties": {
        "enabled": { "type": "boolean" },
        "severity": { "$ref": "#/$defs/severity" },
        "networks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "protocols": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "historyWindowRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "severity", "window_seconds", "accounting_boundary"],
      "properties": {
        "enabled": { "type": "boolean" },
        "severity": { "$ref": "#/$defs/severity" },
        "window_seconds": { "type": "integer", "minimum": 1, "maximum": 2678400 },
        "accounting_boundary": { "$ref": "#/$defs/accountingBoundary" }
      }
    },
    "dailySpendRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "severity", "max_amount", "valuation_asset", "window_seconds", "accounting_boundary", "missing_data"],
      "properties": {
        "enabled": { "type": "boolean" },
        "severity": { "$ref": "#/$defs/severity" },
        "max_amount": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]*|0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*\\.[0-9]+)$"
        },
        "valuation_asset": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._:%-]+/[A-Za-z0-9._:%-]+(?:/[A-Za-z0-9._:%-]+)?$"
        },
        "window_seconds": { "type": "integer", "minimum": 1, "maximum": 2678400 },
        "accounting_boundary": { "$ref": "#/$defs/accountingBoundary" },
        "missing_data": { "$ref": "#/$defs/missingData" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": {
            "properties": {
              "severity": { "enum": ["high", "critical"] },
              "accounting_boundary": { "const": "PERMITTED" },
              "missing_data": { "const": "FINDING" }
            }
          }
        }
      ]
    },
    "firstDestinationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "severity", "normalizer_id", "normalizer_version", "accounting_boundary", "missing_data"],
      "properties": {
        "enabled": { "type": "boolean" },
        "severity": { "$ref": "#/$defs/severity" },
        "normalizer_id": { "const": "atf.agent-commerce.payment.destination.eip155" },
        "normalizer_version": { "const": "1" },
        "accounting_boundary": { "$ref": "#/$defs/accountingBoundary" },
        "missing_data": { "$ref": "#/$defs/missingData" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": {
            "properties": {
              "severity": { "enum": ["high", "critical"] },
              "accounting_boundary": { "const": "PERMITTED" },
              "missing_data": { "const": "FINDING" }
            }
          }
        }
      ]
    },
    "requestFrequencyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "severity", "subject", "action_scope", "max_requests", "window_seconds", "accounting_boundary", "missing_data"],
      "properties": {
        "enabled": { "type": "boolean" },
        "severity": { "$ref": "#/$defs/severity" },
        "subject": { "const": "AGENT" },
        "action_scope": { "const": "PROFILE" },
        "max_requests": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "window_seconds": { "type": "integer", "minimum": 1, "maximum": 2678400 },
        "accounting_boundary": { "const": "REQUESTED" },
        "missing_data": { "$ref": "#/$defs/missingData" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": {
            "properties": {
              "severity": { "enum": ["high", "critical"] },
              "missing_data": { "const": "FINDING" }
            }
          }
        }
      ]
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_expired",
        "single_amount_cap",
        "max_fee_ratio",
        "vendor_price_deviation",
        "high_risk_network_or_protocol",
        "duplicate_purchase"
      ],
      "properties": {
        "request_expired": { "$ref": "#/$defs/toggleRule" },
        "single_amount_cap": { "$ref": "#/$defs/amountCapRule" },
        "max_fee_ratio": { "$ref": "#/$defs/basisPointRule" },
        "vendor_price_deviation": { "$ref": "#/$defs/vendorPriceRule" },
        "high_risk_network_or_protocol": { "$ref": "#/$defs/denyListRule" },
        "duplicate_purchase": { "$ref": "#/$defs/historyWindowRule" },
        "daily_cumulative_spend": { "$ref": "#/$defs/dailySpendRule" },
        "first_time_destination": { "$ref": "#/$defs/firstDestinationRule" },
        "request_frequency": { "$ref": "#/$defs/requestFrequencyRule" }
      }
    }
  }
}
