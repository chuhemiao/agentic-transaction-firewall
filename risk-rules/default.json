      "severity": "high",
      "max_amount": null
    },
    "max_fee_ratio": {
      "enabled": true,
      "severity": "high",
      "threshold_bps": 500,
      "missing_data": "FINDING"
    },
    "vendor_price_deviation": {
      "enabled": true,
      "severity": "high",
      "threshold_bps": 3000,
      "missing_data": "FINDING"
    },
    "high_risk_network_or_protocol": {
      "enabled": true,
      "severity": "high",
